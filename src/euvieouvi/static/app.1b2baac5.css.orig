:root { --evo-ink:#17212b; --evo-muted:#607080; --evo-brand:#176b87; --evo-soft:#eef6f8; --evo-bg:#f6f8fa; --evo-surface:#ffffff; --evo-border:#dfe5ea; }
html[data-theme="light"] { color-scheme: light; }
html[data-theme="dark"] { --evo-ink:#e6edf3; --evo-muted:#9aa8b5; --evo-brand:#4da3c8; --evo-soft:#1a2a33; --evo-bg:#0f1419; --evo-surface:#16202a; --evo-border:#253543; color-scheme: dark; }
body { color:var(--evo-ink); background:var(--evo-bg); min-height:100vh; }
.navbar { background:var(--evo-surface); }
.card,.table-responsive { background:var(--evo-surface); border-color:var(--evo-border); }
.table { --bs-table-bg: var(--evo-surface); --bs-table-color: var(--evo-ink); }
.dropdown-menu { --bs-dropdown-bg: var(--evo-surface); --bs-dropdown-color: var(--evo-ink); }
.navbar-brand { letter-spacing:-.04em; font-weight:750; }
.skip-link { position:absolute; left:-9999px; top:.5rem; z-index:2000; }
.skip-link:focus { left:.5rem; }
.page-shell { max-width:1180px; }
.metric-card { border:0; box-shadow:0 1px 2px rgb(20 35 50 / 8%); }
.metric-value { font-size:1.8rem; font-weight:750; }
.status-dot { width:.65rem; height:.65rem; border-radius:50%; display:inline-block; margin-right:.35rem; }
.status-running,.status-queued { background:#0d6efd; }
.status-succeeded { background:#198754; }
.status-failed { background:#dc3545; }
.status-interrupted { background:#fd7e14; }
.card,.table-responsive { border-color:var(--evo-border); }
.form-label { font-weight:600; }
.htmx-indicator { display:none; }
.htmx-request .htmx-indicator,.htmx-request.htmx-indicator { display:inline-block; }
footer { color:var(--evo-muted); }
.action-toast { color:var(--evo-ink); background:var(--evo-surface); border-color:var(--evo-border); box-shadow:0 .5rem 1rem rgb(0 0 0 / 22%); }
.action-toast .toast-header { color:var(--evo-ink); background:var(--evo-soft); border-color:var(--evo-border); }
.action-toast .toast-body { color:var(--evo-ink); background:var(--evo-surface); }
.media-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(155px,1fr)); gap:1.25rem; }
.media-card { color:var(--evo-ink); min-width:0; }
.media-poster-wrap { position:relative; border-radius:.55rem; overflow:hidden; background:#dfe8ec; box-shadow:0 2px 7px rgb(20 35 50 / 14%); aspect-ratio:2/3; }
.media-poster-wrap-square { aspect-ratio:1/1; }
.media-poster { display:block; width:100%; height:100%; object-fit:cover; transition:transform .18s ease; }
.media-card:hover .media-poster,.media-card:focus .media-poster { transform:scale(1.025); }
.media-card:focus-visible { outline:3px solid #0d6efd; outline-offset:4px; border-radius:.4rem; }
.media-card-body { padding:.55rem .15rem 0; }
.media-title { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.media-badges { position:absolute; right:.45rem; top:.45rem; display:flex; gap:.3rem; }
.media-badge { display:grid; place-items:center; width:1.65rem; height:1.65rem; border-radius:50%; color:#fff; font-size:.75rem; font-weight:800; box-shadow:0 1px 4px rgb(0 0 0 / 30%); }
.is-available { background:#d67a00; }.is-jellyfin { background:#7b3ff2; }.is-played { background:#198754; }
.media-type-badge { display:grid; place-items:center; flex:0 0 1.8rem; width:1.8rem; height:1.8rem; margin-top:.1rem; border-radius:.4rem; color:#fff; font-size:.78rem; font-weight:800; box-shadow:0 1px 3px rgb(0 0 0 / 20%); }
.media-type-tab { position:absolute; top:.45rem; left:0; padding:.22rem .48rem .22rem .4rem; border-radius:0 .3rem .3rem 0; color:#fff; font-size:.67rem; font-weight:800; line-height:1.2; letter-spacing:.025em; text-transform:uppercase; box-shadow:0 1px 3px rgb(0 0 0 / 28%); }
.media-type-badge.is-movie,.media-type-tab.is-movie { background:#2367a8; }
.media-type-badge.is-series,.media-type-tab.is-series { background:#7b4ab4; }
.media-type-badge.is-episode,.media-type-tab.is-episode { background:#b44b65; }
.media-type-badge.is-music,.media-type-tab.is-music { background:#087f6d; }
.min-w-0 { min-width:0; }
.catalog-shell { display:grid; grid-template-columns:4.5rem minmax(0,1fr); gap:1rem; align-items:start; }
.catalog-sidebar { position:sticky; top:1rem; display:flex; flex-direction:column; gap:.25rem; padding:.5rem; background:var(--evo-surface); border:1px solid var(--evo-border); border-radius:.6rem; }
.catalog-type-link { display:grid; place-items:center; min-height:3.5rem; padding:.45rem; border-radius:.4rem; color:var(--evo-muted); text-decoration:none; cursor:grab; }
.catalog-type-link:active { cursor:grabbing; }
.catalog-type-link.catalog-dragging { opacity:.45; }
.catalog-type-link:hover,.catalog-type-link:focus { color:var(--evo-ink); background:var(--evo-soft); }
.catalog-type-link.active { color:var(--evo-brand); background:var(--evo-soft); }
.catalog-type-icon { display:grid; place-items:center; width:2rem; font-size:1.45rem; }
.catalog-filter-icon { min-width:2.35rem; font-size:1rem; font-weight:700; }
@media (max-width: 767.98px) { .catalog-shell { display:block; } .catalog-sidebar { position:static; flex-direction:row; overflow-x:auto; margin-bottom:1rem; } .catalog-type-link { flex:0 0 auto; } }
@media (max-width: 767.98px) { .desktop-only { display:none; } .metric-value { font-size:1.5rem; } }
html[data-theme="dark"] .navbar { --bs-navbar-color: var(--evo-muted); --bs-navbar-hover-color: var(--evo-ink); --bs-navbar-active-color: var(--evo-ink); --bs-navbar-brand-color: var(--evo-ink); --bs-navbar-toggler-border-color: var(--evo-border); background: var(--evo-surface); border-color: var(--evo-border); }
html[data-theme="dark"] .navbar .nav-link { color: var(--evo-muted); }
html[data-theme="dark"] .navbar .nav-link:hover, html[data-theme="dark"] .navbar .nav-link:focus { color: var(--evo-ink); }
html[data-theme="dark"] .navbar .nav-link.active, html[data-theme="dark"] .navbar .nav-link.show { color: var(--evo-ink); }
html[data-theme="dark"] .navbar .dropdown-menu { --bs-dropdown-bg: var(--evo-surface); --bs-dropdown-link-color: var(--evo-ink); --bs-dropdown-link-hover-bg: var(--evo-soft); --bs-dropdown-link-hover-color: var(--evo-ink); --bs-dropdown-border-color: var(--evo-border); }
html[data-theme="dark"] .navbar .dropdown-item { color: var(--evo-ink); }
html[data-theme="dark"] .navbar .dropdown-item:hover, html[data-theme="dark"] .navbar .dropdown-item:focus { background: var(--evo-soft); color: var(--evo-ink); }
html[data-theme="dark"] .navbar-toggler { border-color: var(--evo-border); }
html[data-theme="dark"] .navbar-toggler-icon { filter: invert(1) brightness(1.2); }
html[data-theme="dark"] .navbar .btn-outline-secondary { --bs-btn-color: var(--evo-muted); --bs-btn-border-color: var(--evo-border); --bs-btn-hover-bg: var(--evo-soft); --bs-btn-hover-color: var(--evo-ink); }
html[data-theme="dark"] body { --bs-body-color:var(--evo-ink); --bs-body-bg:var(--evo-bg); --bs-secondary-color:var(--evo-muted); --bs-border-color:var(--evo-border); }
html[data-theme="dark"] .card { --bs-card-color:var(--evo-ink); --bs-card-bg:var(--evo-surface); --bs-card-border-color:var(--evo-border); }
html[data-theme="dark"] .list-group { --bs-list-group-color:var(--evo-ink); --bs-list-group-bg:var(--evo-surface); --bs-list-group-border-color:var(--evo-border); --bs-list-group-action-hover-color:var(--evo-ink); --bs-list-group-action-hover-bg:var(--evo-soft); --bs-list-group-action-active-color:var(--evo-ink); --bs-list-group-action-active-bg:var(--evo-soft); }
html[data-theme="dark"] .accordion { --bs-accordion-color:var(--evo-ink); --bs-accordion-bg:var(--evo-surface); --bs-accordion-border-color:var(--evo-border); --bs-accordion-btn-color:var(--evo-ink); --bs-accordion-btn-bg:var(--evo-surface); --bs-accordion-active-color:var(--evo-ink); --bs-accordion-active-bg:var(--evo-soft); }
html[data-theme="dark"] .form-control,html[data-theme="dark"] .form-select { color:var(--evo-ink); background-color:var(--evo-surface); border-color:var(--evo-border); }
html[data-theme="dark"] .form-control::placeholder { color:var(--evo-muted); }
html[data-theme="dark"] .text-secondary { color:var(--evo-muted)!important; }
html[data-theme="dark"] .alert-light { color:var(--evo-ink); background:var(--evo-surface); border-color:var(--evo-border); }
html[data-theme="dark"] a:not(.btn):not(.nav-link):not(.dropdown-item):not(.media-card) { color:#72bfe0; }
@media (prefers-reduced-motion: reduce) { *,*::before,*::after { scroll-behavior:auto!important; transition:none!important; animation:none!important; } }
