services:
  euvieouvi:
    build:
      context: .
    image: euvieouvi:2.0.0-dev
    container_name: euvieouvi
    init: true
    restart: unless-stopped
    ports:
      - "8000:8000"
    volumes:
      - euvieouvi_data:/data
    read_only: true
    tmpfs:
      - /tmp:size=64m,mode=1777
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD", "python", "-m", "euvieouvi.healthcheck"]
      interval: 30s
      timeout: 5s
      start_period: 10s
      retries: 3
    stop_grace_period: 30s

volumes:
  euvieouvi_data:
